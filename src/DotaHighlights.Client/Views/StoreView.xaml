<UserControl x:Class="DotaHighlights.Client.Views.StoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600">
    <Grid>
        <!-- Fondo de la tienda -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0E1116" Offset="0"/>
                <GradientStop Color="#12161D" Offset="0.5"/>
                <GradientStop Color="#0B0D12" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <DockPanel Margin="28,24">
            <!-- Cabecera -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                <TextBlock Text="Mi Biblioteca" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Capturadores de highlights por juego" FontSize="14"
                           Foreground="#8A93A6" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Rejilla de cards -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="240" Height="330" Margin="0,0,20,20"
                                    Command="{Binding DataContext.OpenCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding Available}"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="card" CornerRadius="12" ClipToBounds="True"
                                                BorderThickness="1" BorderBrush="#22FFFFFF">
                                            <Grid>
                                                <!-- Fondo base (no disponible / gris) -->
                                                <Border x:Name="bgGrey">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                                            <GradientStop Color="#20242C" Offset="0"/>
                                                            <GradientStop Color="#12151B" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- Fondo Dota (carmesí), visible solo si disponible -->
                                                <Border x:Name="bgDota" Opacity="0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
                                                            <GradientStop Color="#7A1E12" Offset="0"/>
                                                            <GradientStop Color="#3A0C0C" Offset="0.55"/>
                                                            <GradientStop Color="#160809" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- Emblema angular tenue -->
                                                <Viewbox Width="200" HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" Opacity="0.10" Margin="0,-40,0,0">
                                                    <Path Fill="#F0783C"
                                                          Data="M50,0 L62,38 L100,38 L70,60 L82,100 L50,74 L18,100 L30,60 L0,38 L38,38 Z"/>
                                                </Viewbox>

                                                <!-- Velo inferior + textos -->
                                                <Border VerticalAlignment="Bottom" Height="130">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00000000" Offset="0"/>
                                                            <GradientStop Color="#DD000000" Offset="0.5"/>
                                                            <GradientStop Color="#F2000000" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,16">
                                                        <TextBlock Text="{Binding Title}" FontSize="18"
                                                                   FontWeight="Bold" Foreground="#FFFFFF"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                                                   Foreground="#C9CDD6" Margin="0,4,0,10"
                                                                   TextWrapping="Wrap"/>
                                                        <Border x:Name="pill" CornerRadius="4" Padding="10,4"
                                                                HorizontalAlignment="Left" Background="#C1440E">
                                                            <TextBlock x:Name="pillText" Text="Entrar ▶"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="#FFFFFF"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <!-- Disponible: fondo Dota + pill de acción -->
                                            <DataTrigger Binding="{Binding Available}" Value="True">
                                                <Setter TargetName="bgDota" Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                            <!-- No disponible: pill "Próximamente" gris -->
                                            <DataTrigger Binding="{Binding Available}" Value="False">
                                                <Setter TargetName="pill" Property="Background" Value="#3A3F49"/>
                                                <Setter TargetName="pillText" Property="Text" Value="Próximamente"/>
                                                <Setter TargetName="card" Property="Opacity" Value="0.55"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="card" Property="BorderBrush" Value="#F0783C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
